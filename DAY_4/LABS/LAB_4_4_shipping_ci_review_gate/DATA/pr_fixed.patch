+"""SwiftPost adapter.  The API key comes from the environment and is only needed for live calls."""
+import os
+
+from .. import packaging, rates, units
+from ..models import Parcel
+
+
+def auth_header() -> dict:
+    return {"Authorization": "Bearer " + os.environ["SWIFTPOST_API_KEY"]}
+
+
+def quote(parcel: Parcel, zone: int) -> int:
+    billable = packaging.billable_weight_kg(units.parcel_kg(parcel), units.parcel_dims_cm(parcel), rates.divisor("swiftpost"))
+    return rates.price_cents(billable, zone)
