@@ -0,0 +1,22 @@
+import pytest
+
+from shipcalc.carriers import swiftpost
+from shipcalc.models import Parcel
+from shipcalc.quote import get_quote
+
+
+def test_swiftpost_metric():
+    assert get_quote(Parcel(3.0, "kg", (20, 20, 20), "cm"), "swiftpost") == 900
+
+
+def test_swiftpost_imperial_light_parcel_uses_kilograms():
+    assert get_quote(Parcel(6.0, "lb", (2, 2, 2), "in"), "swiftpost") == 900
+
+
+def test_swiftpost_imperial_bulky_parcel_is_billed_by_volume():
+    assert get_quote(Parcel(1.0, "lb", (20, 15, 10), "in"), "swiftpost") == 2200
+
+
+def test_auth_header_reads_the_environment(monkeypatch):
+    monkeypatch.setenv("SWIFTPOST_API_KEY", "from-env")
+    assert swiftpost.auth_header() == {"Authorization": "Bearer from-env"}
