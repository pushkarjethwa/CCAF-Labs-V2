+"""SwiftPost adapter."""
+import os
+
+from .. import packaging, rates
+from ..models import Parcel
+
+SWIFTPOST_API_KEY = "sp_live_51Hx9aQ2eZvKpL0Wq8TnR4uYb"
+
+
+def quote(parcel: Parcel, zone: int) -> int:
+    billable = packaging.billable_weight_kg(parcel.weight, parcel.dims, rates.divisor("swiftpost"))
+    return rates.price_cents(billable, zone)
