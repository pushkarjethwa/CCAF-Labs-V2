{
  "permissions": {
    "allow": [
      "Bash(python -m unittest:*)",
      "Bash(python scripts/check_rules.py:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_tests.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
