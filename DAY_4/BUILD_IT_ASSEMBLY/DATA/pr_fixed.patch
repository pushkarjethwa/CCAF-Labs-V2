 """Request handling for the rewards service."""
 from . import ledger
 from .logging_utils import log_event
-from .points import earn_points
+from .points import earn_points, redeem_cost
 
 
 def handle_purchase(request: dict) -> dict:
@@ -16,3 +16,17 @@ def handle_purchase(request: dict) -> dict:
     new_balance = ledger.add(customer_id, points)
     log_event("purchase", customer_id, points=points)
     return {"ok": True, "customer_id": customer_id, "points_earned": points, "balance": new_balance}
+
+
+def quick_redeem(request: dict) -> dict:
+    """Spend points on drinks. Request keys: customer_id, drinks (a whole number)."""
+    customer_id = request.get("customer_id")
+    drinks = request.get("drinks")
+    if not customer_id or not isinstance(drinks, int) or isinstance(drinks, bool) or drinks < 1:
+        return {"ok": False, "error": "customer_id and a whole number of drinks are required"}
+    cost = redeem_cost(drinks)
+    if ledger.balance(customer_id) < cost:
+        return {"ok": False, "error": "not enough points"}
+    new_balance = ledger.add(customer_id, -cost)
+    log_event("redeem", customer_id, points=cost)
+    return {"ok": True, "customer_id": customer_id, "points_spent": cost, "balance": new_balance}
