 CENTS_PER_POINT = 100  # 1 point per whole currency unit spent
 MEMBER_PERCENT = 150  # members earn 150 percent of the base points
+POINTS_PER_DRINK = 100  # whole points a free drink costs
 
 
 def earn_points(amount_cents: int, is_member: bool) -> int:
@@ -12,3 +13,10 @@ def earn_points(amount_cents: int, is_member: bool) -> int:
     if is_member:
         return base * MEMBER_PERCENT // 100
     return base
+
+
+def redeem_cost(drinks: int) -> int:
+    """Return the whole points needed for a number of drinks."""
+    if drinks < 1:
+        raise ValueError("drinks must be at least 1")
+    return drinks * POINTS_PER_DRINK
diff --git a/tests/test_redeem.py b/tests/test_redeem.py
new file mode 100644
--- /dev/null
+++ b/tests/test_redeem.py
@@ -0,0 +1,45 @@
+import os
+import sys
+import unittest
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))
+
+from rewards import ledger
+from rewards.api import quick_redeem
+from rewards.config import get_redeem_key
+from rewards.points import redeem_cost
+
+
+class RedeemTests(unittest.TestCase):
+    def setUp(self):
+        ledger.reset()
+
+    def test_cost_is_whole_points(self):
+        self.assertEqual(redeem_cost(2), 200)
+        with self.assertRaises(ValueError):
+            redeem_cost(0)
+
+    def test_redeem_spends_points(self):
+        ledger.add("c1", 250)
+        result = quick_redeem({"customer_id": "c1", "drinks": 2})
+        self.assertEqual(result, {"ok": True, "customer_id": "c1", "points_spent": 200, "balance": 50})
+
+    def test_not_enough_points(self):
+        ledger.add("c2", 50)
+        self.assertFalse(quick_redeem({"customer_id": "c2", "drinks": 1})["ok"])
+        self.assertEqual(ledger.balance("c2"), 50)
+
+    def test_bad_request(self):
+        self.assertFalse(quick_redeem({"customer_id": "c1", "drinks": 1.5})["ok"])
+        self.assertFalse(quick_redeem({"drinks": 1})["ok"])
+
+    def test_key_comes_from_environment(self):
+        os.environ["REDEEM_API_KEY"] = "from-the-environment"
+        try:
+            self.assertEqual(get_redeem_key(), "from-the-environment")
+        finally:
+            del os.environ["REDEEM_API_KEY"]
+
+
+if __name__ == "__main__":
+    unittest.main()
