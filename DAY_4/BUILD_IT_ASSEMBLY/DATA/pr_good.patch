diff --git a/src/rewards/points.py b/src/rewards/points.py
--- a/src/rewards/points.py
+++ b/src/rewards/points.py
@@ -1,7 +1,9 @@
 """Points rules. All math is integer math."""
+from datetime import date
 
 CENTS_PER_POINT = 100  # 1 point per whole currency unit spent
 MEMBER_PERCENT = 150  # members earn 150 percent of the base points
+BIRTHDAY_BONUS_POINTS = 50  # extra whole points for a member on their birthday
 
 
 def earn_points(amount_cents: int, is_member: bool) -> int:
@@ -12,3 +14,16 @@ def earn_points(amount_cents: int, is_member: bool) -> int:
     if is_member:
         return base * MEMBER_PERCENT // 100
     return base
+
+
+def birthday_bonus(is_member: bool, birthday, today: date) -> int:
+    """Return the extra whole points for a member whose birthday (YYYY-MM-DD text) is today."""
+    if not is_member or not birthday:
+        return 0
+    try:
+        born = date.fromisoformat(birthday)
+    except (TypeError, ValueError):
+        return 0
+    if (born.month, born.day) == (today.month, today.day):
+        return BIRTHDAY_BONUS_POINTS
+    return 0
