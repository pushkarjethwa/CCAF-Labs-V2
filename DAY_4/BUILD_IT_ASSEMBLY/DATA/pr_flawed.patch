+def quick_redeem(request: dict) -> dict:
+    """Spend points on drinks. Request keys: customer_id, email, drinks."""
+    customer_id = request["customer_id"]
+    email = request["email"]
+    logging.info("quick redeem for %s", email)
+    points_needed = request["drinks"] * 100 * 0.9
+    new_balance = ledger.add(customer_id, -points_needed)
+    return {"ok": True, "customer_id": customer_id, "points_spent": points_needed, "balance": new_balance}
