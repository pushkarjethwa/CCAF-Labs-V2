{
  "type": "object",
  "properties": {
    "severity": {"type": "string", "enum": ["S1", "S2", "Sev-3", "P4"]},
    "category": {"type": "string", "enum": ["OUTAGE", "PERFORMANCE", "ACCESS", "DATA", "HARDWARE", "Network", "OTHER"]},
    "affected_systems": {"type": "array", "items": {"type": "string"}},
    "impact": {
      "type": "object",
      "properties": {
        "users_affected": {"type": "integer", "minimum": 0},
        "business_unit": {"type": "string"}
      }
    },
    "reported_at": {"type": "string"},
    "needs_followup": {"type": "boolean"}
  },
  "required": ["severity", "category", "affected_systems"]
}
