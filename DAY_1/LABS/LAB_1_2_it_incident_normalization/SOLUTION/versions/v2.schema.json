{
  "type": "object",
  "properties": {
    "severity": {
      "type": "string",
      "enum": [
        "S1",
        "S2",
        "S3",
        "S4"
      ],
      "description": "S1 outage or breach for customers/company, S2 team-wide major impact, S3 one user or workaround exists, S4 request or no current impact."
    },
    "category": {
      "type": "string",
      "enum": [
        "OUTAGE",
        "PERFORMANCE",
        "ACCESS",
        "SECURITY",
        "DATA",
        "HARDWARE",
        "OTHER"
      ],
      "description": "OUTAGE = unavailable, PERFORMANCE = slow or intermittent, ACCESS = login or permission, SECURITY, DATA = wrong or stale data, HARDWARE, OTHER = requests."
    },
    "affected_systems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lowercase canonical system names, one array element per system."
    },
    "impact": {
      "type": "object",
      "properties": {
        "users_affected": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "business_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "users_affected",
        "business_unit"
      ],
      "additionalProperties": false
    },
    "reported_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "needs_followup": {
      "type": "boolean"
    }
  },
  "required": [
    "severity",
    "category",
    "affected_systems",
    "impact",
    "reported_at",
    "needs_followup"
  ],
  "additionalProperties": false
}
