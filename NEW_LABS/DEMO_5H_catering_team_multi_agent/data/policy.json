{
  "_note": "Author-written. The ONE table: roles, limits and hand-off schemas. The gate, the agent definitions and the validators all read it.",
  "roles": {
    "orchestrator": ["Agent", "record_order"],
    "stock_checker": ["check_stock"],
    "pricer": ["get_price"],
    "scheduler": ["read_calendar", "reserve_slot"]
  },
  "limits": {
    "approval_limit_usd": 300,
    "max_quantity_per_line": 200,
    "max_lines_per_request": 5,
    "first_slot": "08:00",
    "last_slot": "15:30",
    "orchestrator_max_turns": 40,
    "subagent_max_turns": {"stock_checker": 4, "pricer": 4, "scheduler": 6},
    "max_budget_usd": 1.00
  },
  "schemas": {
    "stock_checker": {
      "request_id": {"type": "string", "pattern": "R-\\d+"},
      "status": {"type": "string", "enum": ["in_stock", "short"]},
      "note": {"type": "string", "max_len": 200}
    },
    "pricer": {
      "request_id": {"type": "string", "pattern": "R-\\d+"},
      "total_usd": {"type": "number", "min": 0},
      "discount_usd": {"type": "number", "min": 0},
      "note": {"type": "string", "max_len": 200}
    },
    "scheduler": {
      "request_id": {"type": "string", "pattern": "R-\\d+"},
      "status": {"type": "string", "enum": ["reserved", "held_for_approval", "no_slot"]},
      "slot": {"type": "string", "pattern": "(\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d)?"},
      "note": {"type": "string", "max_len": 200}
    }
  }
}
